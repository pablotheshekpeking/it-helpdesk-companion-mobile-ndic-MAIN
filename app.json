{
  "expo": {
    "name": "Fincra IT Support",
    "slug": "fincra-helpdesk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ithelpdesk",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.fincra.ithelpdesk",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fincra.ithelpdesk",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9d9fd0e9-6e85-4f95-b6ff-f2df9e26a00f"
      }
    },
    "owner": "ithelpdesk-yyy"
  }
}
